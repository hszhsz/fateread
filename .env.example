# ============================================================
# FateRead 配置文件
# 复制此文件为 .env 并填入你的配置
# ============================================================

# DeepSeek API Key（必填）
# 申请地址：https://platform.deepseek.com/
OPENAI_API_KEY=sk-your-deepseek-api-key-here

# API 基础地址（默认 DeepSeek）
# 如需使用其他兼容 OpenAI 格式的服务，修改此项
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名称（默认 deepseek-v4-pro）
# 可选：deepseek-v4-pro, deepseek-chat, gpt-4o 等
FATEREAD_MODEL=deepseek-v4-pro

# 最大 Token 数（默认 262144 即 256k）
# 推理模型（如 DeepSeek V4 Pro）的 reasoning + output 共享此额度
# 不同模型上下文窗口不同，请根据所用模型调整：
#   DeepSeek V4 Pro: 262144 (256k) ~ 1048576 (1M)
#   GPT-4o:          128000 (128k)
#   GLM-4:           128000 (128k)
#   Qwen2.5-72B:     131072 (128k)
# FATEREAD_MAX_TOKENS=262144
