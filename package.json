{
  "name": "fateread",
  "version": "0.1.0",
  "description": "AI-powered Chinese BaZi (Four Pillars of Destiny) fortune reading agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fateread": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "benchmark": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.json --verbose",
    "benchmark:ziping": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.json --verbose -t '子平八字'",
    "benchmark:ziwei": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.json --verbose -t '紫微斗数'",
    "benchmark:mangpai": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.json --verbose -t '盲派命理'",
    "lint": "eslint src/"
  },
  "keywords": [
    "bazi",
    "fortune-telling",
    "chinese-astrology",
    "four-pillars",
    "ai-agent"
  ],
  "author": "hszhsz",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "inquirer": "^9.2.0",
    "openai": "^4.50.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
